---
// src/layouts/BlogPost.astro
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | JunkLab</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <!-- 共通ヘッダー -->
    <header class="header">
      <a href="/" class="logo">
        <span class="logo-icon">⚙</span> JunkLab
      </a>
      <div class="header-right">
        <nav class="nav-menu">
          <a href="/profile">PROFILE</a>
        </nav>
        <a href="https://youtube.com/" target="_blank" class="btn-youtube">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
          YouTube
        </a>
      </div>
    </header>

    <main>
      <div class="article-container">
        <article class="article-card">
          <!-- 記事ヘッダー（カテゴリー・日付・タイトル） -->
          <div class="article-header">
            <div class="article-meta">
              <span class="tag">{category || 'JUNK'}</span>
              <time class="date">
                公開日: {pubDate.toLocaleDateString('ja-JP')}
              </time>
              {updatedDate && (
                <time class="date updated">
                  (更新: {updatedDate.toLocaleDateString('ja-JP')})
                </time>
              )}
            </div>
            <h1 class="article-title">{title}</h1>
          </div>

          <!-- サムネイル画像（設定されている場合のみ表示） -->
          {heroImage && (
            <div class="hero-image">
              <img src={heroImage} alt={title} />
            </div>
          )}

          <!-- 記事本文（Pages CMSで書いた内容がここに入る） -->
          <div class="prose">
            <slot />
          </div>

          <!-- 記事下部のYouTube誘導＆戻るリンク -->
          <div class="article-footer">
            <div class="youtube-cta">
              <p>Youtubeチャンネルはこちらから！</p>
              <a href="https://youtube.com/" target="_blank" class="btn-youtube-large">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
                YouTubeで動画を見る
              </a>
            </div>

            <div class="back-link">
              <a href="/">← 最新記事一覧（トップ）へ戻る</a>
            </div>
          </div>
        </article>
      </div>
    </main>

    <!-- 共通フッター -->
    <footer class="footer">
      <div class="footer-content">
        <div class="footer-links">
          <a href="/sitemap">サイトマップ</a>
          <a href="/privacy-policy">プライバシーポリシー</a>
          <a href="/contact">お問い合わせ</a>
        </div>
        <p class="copyright">&copy; 2026 JunkLab. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg-color: #FAFAFA;
    --text-color: #2D3748;
    --color-blue-dark: #0726D9;
    --color-cyan: #07C7F2;
    --color-orange: #F28907;
    --card-border: #E2E8F0;
    --footer-bg: #1A202C; 
  }

  html, body {
    margin: 0;
    padding: 0;
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
    color: var(--text-color) !important;
    background-color: var(--bg-color) !important;
    background-image: linear-gradient(#e5e7eb 1px, transparent 1px),
                      linear-gradient(90deg, #e5e7eb 1px, transparent 1px) !important;
    background-size: 20px 20px !important;
  }

  main { min-height: 80vh; }

  /* ヘッダー */
  .header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 5%;
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 3px solid var(--color-blue-dark);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    position: sticky;
    top: 0;
    z-index: 10;
    gap: 1rem;
  }
  .header-right { display: flex; flex-wrap: wrap; align-items: center; gap: 2rem; }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--color-blue-dark);
    text-decoration: none;
    letter-spacing: -0.5px;
  }
  .logo-icon { color: var(--color-cyan); font-size: 1.4rem; }
  .nav-menu { display: flex; gap: 1.5rem; }
  .nav-menu a {
    text-decoration: none;
    color: var(--text-color);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
  }
  .btn-youtube {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-orange);
    color: #fff;
    padding: 0.5rem 1.2rem;
    text-decoration: none;
    border-radius: 4px;
    font-weight: bold;
    font-size: 0.9rem;
    transition: all 0.2s ease;
    border: 2px solid transparent;
  }
  .btn-youtube:hover {
    background-color: transparent;
    color: var(--color-orange);
    border-color: var(--color-orange);
  }

  /* 記事全体のコンテナ */
  .article-container {
    max-width: 840px;
    margin: 0 auto;
    padding: 3rem 5% 5rem;
  }
  .article-card {
    background-color: #FFFFFF;
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 3rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
  }

  /* 記事タイトル周り */
  .article-header {
    border-bottom: 2px solid #EDF2F7;
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }
  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .tag {
    display: inline-block;
    background-color: rgba(7, 199, 242, 0.12);
    color: var(--color-blue-dark);
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.3rem 0.8rem;
    border-radius: 4px;
    letter-spacing: 1px;
  }
  .date {
    font-size: 0.9rem;
    color: #718096;
    font-weight: bold;
  }
  .article-title {
    margin: 0;
    color: var(--color-blue-dark);
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.4;
  }

  /* サムネイル画像 */
  .hero-image {
    margin-bottom: 2.5rem;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--card-border);
  }
  .hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* 記事本文（Markdown）の装飾 */
  .prose {
    font-size: 1.05rem;
    line-height: 1.9;
    color: #2D3748;
  }
  .prose h2 {
    color: var(--color-blue-dark);
    font-size: 1.5rem;
    margin: 3rem 0 1.2rem;
    padding-bottom: 0.5rem;
    border-bottom: 3px solid var(--color-cyan);
  }
  .prose h3 {
    color: var(--color-blue-dark);
    font-size: 1.25rem;
    margin: 2.2rem 0 1rem;
    border-left: 4px solid var(--color-cyan);
    padding-left: 0.8rem;
  }
  .prose p {
    margin: 0 0 1.5rem 0;
  }
  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--card-border);
    margin: 1.5rem 0;
  }
  .prose ul, .prose ol {
    margin: 0 0 1.5rem 0;
    padding-left: 1.8rem;
  }
  .prose li {
    margin-bottom: 0.5rem;
  }
  .prose blockquote {
    margin: 1.5rem 0;
    padding: 1rem 1.5rem;
    background-color: #F7FAFC;
    border-left: 4px solid var(--color-blue-dark);
    color: #4A5568;
    border-radius: 0 8px 8px 0;
  }
  .prose pre {
    background-color: #1A202C;
    color: #F7FAFC;
    padding: 1.2rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .prose a {
    color: var(--color-blue-dark);
    font-weight: bold;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose a:hover {
    color: var(--color-cyan);
  }

  /* 記事下部のYouTube誘導ボックス */
  .article-footer {
    margin-top: 4rem;
  }
  .youtube-cta {
    background: linear-gradient(135deg, rgba(7, 38, 217, 0.04) 0%, rgba(7, 199, 242, 0.1) 100%);
    border: 2px solid var(--color-cyan);
    border-radius: 10px;
    padding: 2rem;
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .youtube-cta p {
    margin: 0 0 1.2rem 0;
    font-weight: bold;
    color: var(--color-blue-dark);
    font-size: 1.05rem;
  }
  .btn-youtube-large {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background-color: var(--color-orange);
    color: #fff;
    padding: 0.8rem 2rem;
    text-decoration: none;
    border-radius: 6px;
    font-weight: bold;
    font-size: 1.05rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .btn-youtube-large:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(242, 137, 7, 0.35);
  }

  .back-link {
    padding-top: 1.5rem;
    border-top: 1px solid var(--card-border);
  }
  .back-link a {
    color: var(--color-blue-dark);
    text-decoration: none;
    font-weight: bold;
    font-size: 0.95rem;
  }
  .back-link a:hover { color: var(--color-cyan); }

  @media (max-width: 640px) {
    .article-card {
      padding: 1.5rem;
    }
    .article-title {
      font-size: 1.5rem;
    }
  }

  /* フッター */
  .footer { background-color: var(--footer-bg); color: #ffffff; padding: 3rem 5%; }
  .footer-content { max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
  .footer-links { display: flex; gap: 2rem; flex-wrap: wrap; justify-content: center; }
  .footer-links a { color: #A0AEC0; text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
  .footer-links a:hover { color: var(--color-cyan); }
  .copyright { font-size: 0.8rem; color: #718096; margin: 0; }
</style>