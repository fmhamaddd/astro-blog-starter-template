---
// src/pages/index.astro
import { getCollection } from 'astro:content';

// blogフォルダ内の記事を取得し、日付の新しい順（降順）に並び替える
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<html lang="ja">
<link rel="icon" type="image/png" href="/favicon.png" />
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>JunkLab | ジャンクのエモさ</title>
  </head>
  <body>
    <!-- ヘッダー -->
    <header class="header">
      <a href="/" class="logo">
        <span class="logo-icon">⚙</span> JunkLab
      </a>
      <div class="header-right">
        <nav class="nav-menu">
          <a href="/profile">PROFILE</a>
        </nav>
        <a href="https://www.youtube.com/@SSRONEJR" target="_blank" class="btn-youtube">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
          YouTube
        </a>
      </div>
    </header>

    <main>
      <!-- ヒーローセクション -->
      <section class="hero">
        <div class="hero-content">
          <h1>REBUILD & CUSTOMIZE</h1>
          <p>ジャンクの修復に、エモさを見出す<br>JunkLabの修理ログとレビュー</p>
        </div>
      </section>

      <!-- 最新記事リスト（左サムネ・右テキストの横長一覧） -->
      <section class="content">
        <h2>LATEST REPORTS</h2>
        <div class="post-list">
          {posts.map((post) => (
            <a href={`/blog/${post.id}/`} class="card">
              <div class="card-img">
                {post.data.heroImage ? (
                  <img src={post.data.heroImage} alt={post.data.title} />
                ) : (
                  <span>No Image</span>
                )}
              </div>
              <div class="card-body">
                <div class="card-meta">
                  <span class="tag">{post.data.category}</span>
                  <time class="date">
                    {post.data.pubDate.toLocaleDateString('ja-JP')}
                  </time>
                </div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    </main>

    <!-- フッター -->
    <footer class="footer">
      <div class="footer-content">
        <div class="footer-links">
          <a href="/sitemap">サイトマップ</a>
          <a href="/privacy-policy">プライバシーポリシー</a>
          <a href="/contact">お問い合わせ</a>
        </div>
        <p class="copyright">&copy; 2026 JunkLab. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg-color: #FAFAFA;
    --text-color: #2D3748;
    --color-blue-dark: #0726D9;
    --color-cyan: #07C7F2;
    --color-orange: #F28907;
    --card-border: #E2E8F0;
    --footer-bg: #1A202C; 
  }

  html, body {
    margin: 0;
    padding: 0;
    font-family: 'Inter', 'Helvetica Neue', Arial, sans-serif;
    color: var(--text-color) !important;
    background-color: var(--bg-color) !important;
    background-image: linear-gradient(#e5e7eb 1px, transparent 1px),
                      linear-gradient(90deg, #e5e7eb 1px, transparent 1px) !important;
    background-size: 20px 20px !important;
  }

  main { min-height: 80vh; }

  /* ヘッダー */
  .header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 5%;
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: 3px solid var(--color-blue-dark);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    position: sticky;
    top: 0;
    z-index: 10;
    gap: 1rem;
  }
  .header-right { display: flex; flex-wrap: wrap; align-items: center; gap: 2rem; }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--color-blue-dark);
    text-decoration: none;
    letter-spacing: -0.5px;
  }
  .logo-icon { color: var(--color-cyan); font-size: 1.4rem; }
  .nav-menu { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .nav-menu a {
    text-decoration: none;
    color: var(--text-color);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
    transition: color 0.2s;
    white-space: nowrap;
    position: relative;
  }
  .nav-menu a::after {
    content: '';
    position: absolute;
    width: 0;
    height: 2px;
    bottom: -4px;
    left: 0;
    background-color: var(--color-cyan);
    transition: width 0.3s;
  }
  .nav-menu a:hover { color: var(--color-blue-dark); }
  .nav-menu a:hover::after { width: 100%; }

  .btn-youtube {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-orange);
    color: #fff;
    padding: 0.5rem 1.2rem;
    text-decoration: none;
    border-radius: 4px;
    font-weight: bold;
    font-size: 0.9rem;
    white-space: nowrap;
    transition: all 0.2s ease;
    border: 2px solid transparent;
  }
  .btn-youtube:hover {
    background-color: transparent;
    color: var(--color-orange);
    border-color: var(--color-orange);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(242, 137, 7, 0.2);
  }

  /* ヒーローセクション */
  .hero { padding: 4rem 1rem 2rem; display: flex; justify-content: center; }
  .hero-content {
    text-align: center;
    background-color: #fff;
    padding: 3rem 2rem;
    border-radius: 12px;
    box-shadow: 0 10px 25px -5px rgba(7, 38, 217, 0.1);
    border: 1px solid var(--card-border);
    max-width: 900px;
    width: 100%;
  }
  .hero h1 {
    color: var(--color-blue-dark);
    font-size: 2.5rem;
    font-weight: 900;
    letter-spacing: 1px;
    margin: 0 0 1rem 0;
    background: linear-gradient(to right, var(--color-blue-dark), var(--color-cyan));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero p { color: #4A5568; font-size: 1rem; line-height: 1.8; margin: 0; }

  /* 記事一覧エリア（リスト表示用に幅を900pxに最適化） */
  .content { padding: 2rem 5% 5rem; max-width: 900px; margin: 0 auto; }
  .content h2 {
    display: inline-block;
    border-bottom: 4px solid var(--color-cyan);
    padding-bottom: 0.5rem;
    color: var(--color-blue-dark);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 1px;
    margin-bottom: 2rem;
  }

  /* 縦に並べるリスト構造 */
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* 横長記事カード（左：画像、右：テキスト） */
  .card {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    text-decoration: none;
    color: inherit;
    background-color: #FFFFFF;
    border: 1px solid var(--card-border);
    border-radius: 10px;
    overflow: hidden;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    box-shadow: 0 2px 5px rgba(0,0,0,0.03);
  }
  .card:hover {
    transform: translateX(6px); /* ホバー時に少し右へスライドさせる演出 */
    border-color: var(--color-cyan);
    box-shadow: 0 10px 20px rgba(7, 38, 217, 0.08);
  }

  /* 左側のサムネイル画像枠（YouTubeサムネ等の16:9比率に合わせやすいサイズ） */
  .card-img {
    width: 280px;
    min-height: 170px;
    flex-shrink: 0;
    background-color: #EDF2F7;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #A0AEC0;
    font-weight: bold;
    border-right: 1px solid var(--card-border);
    overflow: hidden;
  }
  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .card:hover .card-img img {
    transform: scale(1.05);
  }

  /* 右側のテキストエリア */
  .card-body {
    padding: 1.5rem 2rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .card-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }
  .tag {
    display: inline-block;
    background-color: rgba(7, 199, 242, 0.12);
    color: var(--color-blue-dark);
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 1px;
  }
  .date {
    font-size: 0.85rem;
    color: #718096;
    font-weight: bold;
  }
  /* フッター */
  .footer { background-color: var(--footer-bg); color: #ffffff; padding: 3rem 5%; }
  .footer-content { max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
  .footer-links { display: flex; gap: 2rem; flex-wrap: wrap; justify-content: center; }
  .footer-links a { color: #A0AEC0; text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
  .footer-links a:hover { color: var(--color-cyan); }
  .copyright { font-size: 0.8rem; color: #718096; margin: 0; }
</style>